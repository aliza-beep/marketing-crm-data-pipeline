# Local zero-cost default. Copy to .env; never commit .env.
DATABASE_URL=sqlite:///data/marketing.db
APP_ENV=development
LOG_LEVEL=INFO
SIMULATION_SEED=42
WEBHOOK_SECRET=replace-with-a-long-random-value

# Optional Supabase Transaction Pooler / PostgreSQL URL:
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:6543/postgres?sslmode=require

# Optional Claude diagnostic enhancement. The deterministic fallback needs no key.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Reserved for future real connectors; not used by the simulated MVP.
# GOOGLE_ADS_DEVELOPER_TOKEN=
# META_ADS_ACCESS_TOKEN=
# GA4_PROPERTY_ID=
# CRM_API_TOKEN=

